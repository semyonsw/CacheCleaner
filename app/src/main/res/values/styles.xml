<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:colorPrimary">#5A55E8</item>
        <item name="android:colorPrimaryDark">#4540C4</item>
        <item name="android:colorAccent">#8B5CF6</item>
        <item name="android:navigationBarColor">#F4F7FB</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">#F4F7FB</item>
    </style>

    <style name="SecondaryButton" parent="@android:style/Widget.Material.Button">
        <item name="android:background">@drawable/button_primary</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textSize">14sp</item>
    </style>
</resources>
